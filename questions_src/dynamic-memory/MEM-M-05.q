@@@ harness_code
#include <stddef.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

/*USER_CODE*/

int main(void)
{
    char op[4];
    while (scanf("%3s", op) == 1) {
        unsigned long long r64, c64;
        unsigned int seed = 0;
        if (scanf("%llu %llu", &r64, &c64) != 2)
            return 0;
        if (op[0] == 'G' && scanf("%u", &seed) != 1)
            return 0;
        size_t rows = (size_t)r64, cols = (size_t)c64;

        double **m = matrix_alloc(rows, cols);
        if (m == NULL) {
            printf("alloc %llux%llu: NULL\n", r64, c64);
            continue;
        }
        printf("alloc %llux%llu: ok\n", r64, c64);
        if (rows > 1000000 || cols > 1000000 || rows * cols > 1000000) {
            printf("FAIL: this size must be rejected\n");
            free(m);
            continue;
        }

        int zeroed = 1, contiguous = 1;
        for (size_t i = 0; i < rows; i++) {
            if (m[i] != m[0] + i * cols)
                contiguous = 0;
        }
        if (!contiguous) {
            printf("FAIL: rows are not contiguous\n");
            free(m);
            continue;
        }
        for (size_t i = 0; i < rows; i++)
            for (size_t j = 0; j < cols; j++)
                if (m[i][j] != 0.0)
                    zeroed = 0;
        int aligned = ((uintptr_t)m[0] % _Alignof(double)) == 0;
        printf("zeroed=%s contiguous=yes aligned=%s\n", zeroed ? "yes" : "no", aligned ? "yes" : "no");

        for (size_t i = 0; i < rows; i++)
            for (size_t j = 0; j < cols; j++) {
                int v = 0;
                if (op[0] == 'G') {
                    seed = seed * 1103515245u + 12345u;
                    v = (int)((seed >> 16) % 100u);
                } else if (scanf("%d", &v) != 1) {
                    v = 0;
                }
                m[i][j] = v;
            }

        double **t = matrix_transpose(m, rows, cols);
        if (t == NULL) {
            printf("transpose: NULL\n");
            free(m);
            continue;
        }
        if (rows * cols <= 30) {
            for (size_t i = 0; i < rows; i++)
                for (size_t j = 0; j < cols; j++)
                    printf("%g%c", m[i][j], j + 1 == cols ? '\n' : ' ');
            printf("transpose %zux%zu:\n", cols, rows);
            for (size_t j = 0; j < cols; j++)
                for (size_t i = 0; i < rows; i++)
                    printf("%g%c", t[j][i], i + 1 == rows ? '\n' : ' ');
        } else {
            long long sum = 0;
            int ok = 1;
            for (size_t i = 0; i < rows; i++)
                for (size_t j = 0; j < cols; j++) {
                    sum += (long long)m[i][j] * (long long)((i * 31 + j) % 97 + 1);
                    if (t[j][i] != m[i][j])
                        ok = 0;
                }
            printf("checksum=%lld\n", sum);
            printf("transpose %zux%zu: %s\n", cols, rows, ok ? "ok" : "MISMATCH");
        }
        free(t);   /* one free per matrix */
        free(m);
    }
    return 0;
}
