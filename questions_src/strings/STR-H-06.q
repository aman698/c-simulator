@@@ harness_code
#include <stdio.h>
#include <string.h>
#include <stddef.h>

/*USER_CODE*/

static char line[20600];
static char pat[400], txt[20100];

/* parse the next token: "..." into out (returns 1), or NULL (returns 0); advances *pp */
static int next_arg(const char **pp, char *out, size_t cap)
{
    const char *p = *pp;
    while (*p == ' ') p++;
    if (strncmp(p, "NULL", 4) == 0) {
        *pp = p + 4;
        return 0;
    }
    size_t n = 0;
    if (*p == '"') p++;
    while (*p && *p != '"' && *p != '\n') {
        if (n + 1 < cap) out[n++] = *p;
        p++;
    }
    if (*p == '"') p++;
    out[n] = '\0';
    *pp = p;
    return 1;
}

int main(void)
{
    int q;
    if (!fgets(line, sizeof line, stdin) || sscanf(line, "%d", &q) != 1) return 0;
    for (int i = 0; i < q; i++) {
        if (!fgets(line, sizeof line, stdin)) return 0;
        const char *p = line;
        const char *a = next_arg(&p, pat, sizeof pat) ? pat : NULL;
        const char *b = next_arg(&p, txt, sizeof txt) ? txt : NULL;
        puts(wildcard_match(a, b) ? "MATCH" : "NO MATCH");
    }
    return 0;
}
@@@ sample_input
3
"P03*" "P0301"
"ENG_*_TEMP" "ENG_OIL_TEMP"
"a*c?b" "acdcb"
@@@ sample_output
