@@@ harness_code
#include <stdio.h>
#include <stdint.h>
#include <stddef.h>
#include <string.h>

/*USER_CODE*/

static uint8_t g_buf[100000];

int main(void)
{
    int q;
    if (scanf("%d", &q) != 1) return 0;
    for (int k = 0; k < q; k++) {
        char op;
        uint8_t crc;
        if (scanf(" %c", &op) != 1) return 0;
        if (op == 'S') {
            char text[256];
            if (scanf("%255s", text) != 1) return 0;
            memcpy(g_buf, text, strlen(text));
            crc = crc8_sae_j1850(g_buf, strlen(text));
        } else if (op == 'H') {
            int n;
            if (scanf("%d", &n) != 1 || n < 0 || n > 100000) return 0;
            for (int i = 0; i < n; i++) {
                unsigned b;
                if (scanf("%x", &b) != 1) return 0;
                g_buf[i] = (uint8_t)b;
            }
            crc = crc8_sae_j1850(n ? g_buf : NULL, (size_t)n);
        } else {
            unsigned seed;
            int n;
            if (scanf("%u %d", &seed, &n) != 2 || n < 0 || n > 100000) return 0;
            uint32_t s = seed;
            for (int i = 0; i < n; i++) {
                s = s * 1103515245u + 12345u;
                g_buf[i] = (uint8_t)(s >> 24);
            }
            crc = crc8_sae_j1850(g_buf, (size_t)n);
        }
        printf("%02X\n", (unsigned)crc);
    }
    return 0;
}
