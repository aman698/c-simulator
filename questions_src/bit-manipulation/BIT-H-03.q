@@@ harness_code
#include <stdio.h>
#include <stdint.h>
#include <stddef.h>
#include <string.h>

/*USER_CODE*/

static uint8_t g_buf[1024];

int main(void)
{
    int q;
    if (scanf("%d", &q) != 1) return 0;
    crc16_init_table();
    for (int k = 0; k < q; k++) {
        char op;
        if (scanf(" %c", &op) != 1) return 0;
        if (op == 'T') {
            int i;
            if (scanf("%d", &i) != 1 || i < 0 || i > 255) return 0;
            const uint16_t *t = crc16_table();
            if (!t) { printf("NULL TABLE\n"); return 0; }
            printf("%04X\n", (unsigned)t[i]);
        } else if (op == 'S' || op == 'K') {
            char text[256];
            size_t cut = 0;
            if (scanf("%255s", text) != 1) return 0;
            size_t len = strlen(text);
            if (op == 'K' && (scanf("%zu", &cut) != 1 || cut > len)) return 0;
            memcpy(g_buf, text, len);
            uint16_t c;
            if (op == 'S') {
                c = crc16_update(0xFFFFu, g_buf, len);
            } else {
                c = crc16_update(0xFFFFu, g_buf, cut);
                c = crc16_update(c, g_buf + cut, len - cut);
            }
            printf("%04X\n", (unsigned)c);
        } else if (op == 'F') {
            int n;
            if (scanf("%d", &n) != 1 || n < 0 || n > 1000) return 0;
            for (int i = 0; i < n; i++) {
                unsigned b;
                if (scanf("%x", &b) != 1) return 0;
                g_buf[i] = (uint8_t)b;
            }
            uint16_t c = crc16_update(0xFFFFu, n ? g_buf : NULL, (size_t)n);
            g_buf[n] = (uint8_t)(c >> 8);
            g_buf[n + 1] = (uint8_t)(c & 0xFFu);
            uint16_t r = crc16_update(0xFFFFu, g_buf, (size_t)n + 2u);
            printf("crc=%04X residue=%04X\n", (unsigned)c, (unsigned)r);
        } else {
            unsigned seed;
            long long n;
            if (scanf("%u %lld", &seed, &n) != 2) return 0;
            uint32_t s = seed;
            uint16_t c = 0xFFFFu;
            while (n > 0) {
                int chunk = n > 1000 ? 1000 : (int)n;
                for (int i = 0; i < chunk; i++) {
                    s = s * 1103515245u + 12345u;
                    g_buf[i] = (uint8_t)(s >> 24);
                }
                c = crc16_update(c, g_buf, (size_t)chunk);
                n -= chunk;
            }
            printf("%04X\n", (unsigned)c);
        }
    }
    return 0;
}
