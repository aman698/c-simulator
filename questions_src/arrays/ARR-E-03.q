@@@ harness_code
#include <stdio.h>
#include <string.h>
#include <stddef.h>
#include <stdint.h>

/*USER_CODE*/

#define MAXN 200000
#define GUARD 16
#define CANARY 0x0BADF00D

static int arena[GUARD + MAXN + GUARD];
static int ref[MAXN];

static int guards_ok(int n)
{
    for (int i = 0; i < GUARD; i++)
        if (arena[i] != CANARY || arena[GUARD + n + i] != CANARY) return 0;
    return 1;
}

int main(void)
{
    char tok[16];
    int n;
    int gen = 0;
    unsigned int seed = 0;
    if (scanf("%15s", tok) != 1) return 0;
    if (strcmp(tok, "GEN") == 0) {
        gen = 1;
        if (scanf("%d %u", &n, &seed) != 2) return 0;
    } else if (sscanf(tok, "%d", &n) != 1) {
        return 0;
    }
    if (n < 0 || n > MAXN) return 0;

    for (int i = 0; i < GUARD + MAXN + GUARD; i++) arena[i] = CANARY;
    int *a = arena + GUARD;

    if (gen) {
        uint32_t x = seed;
        for (int i = 0; i < n; i++) {
            x = x * 1103515245u + 12345u;
            a[i] = ((x >> 16) & 1u) ? 0 : (int)((x >> 8) % 2001u) - 1000;
        }
    } else {
        for (int i = 0; i < n; i++)
            if (scanf("%d", &a[i]) != 1) return 0;
    }

    int expect = 0;
    for (int i = 0; i < n; i++)
        if (a[i] != 0) ref[expect++] = a[i];
    for (int i = expect; i < n; i++) ref[i] = 0;

    int k = move_zeros(n == 0 ? NULL : a, n);

    if (!guards_ok(n)) {
        printf("OUT OF BOUNDS WRITE\n");
        return 0;
    }
    printf("count: %d\n", k);
    if (gen) {
        int same = (k == expect);
        for (int i = 0; same && i < n; i++)
            if (a[i] != ref[i]) same = 0;
        printf("%s\n", same ? "OK" : "WRONG");
    } else if (n > 0) {
        for (int i = 0; i < n; i++) printf("%d%c", a[i], i == n - 1 ? '\n' : ' ');
    }
    return 0;
}
