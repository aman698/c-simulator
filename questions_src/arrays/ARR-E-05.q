@@@ harness_code
#include <stdio.h>
#include <string.h>
#include <stdint.h>

/*USER_CODE*/

#define MAXN 100000
#define GUARD 8
#define CANARY ((int64_t)0x5AFE5AFE5AFE5AFELL)

static int32_t a[MAXN];
static int64_t pbuf[MAXN + 1 + GUARD];
static int64_t ref[MAXN + 1];

static uint32_t lcg(uint32_t *x)
{
    *x = *x * 1103515245u + 12345u;
    return *x;
}

int main(void)
{
    char tok[16];
    int n, q;
    int gen = 0;
    uint32_t x = 0;
    if (scanf("%15s", tok) != 1) return 0;
    if (strcmp(tok, "GEN") == 0) {
        unsigned int seed;
        if (scanf("%d %d %u", &n, &q, &seed) != 3) return 0;
        gen = 1;
        x = seed;
    } else {
        if (sscanf(tok, "%d", &n) != 1 || scanf("%d", &q) != 1) return 0;
    }
    if (n < 1 || n > MAXN || q < 1) return 0;

    for (int i = 0; i < n; i++) {
        if (gen) {
            a[i] = (int32_t)((int64_t)lcg(&x) - 2147483648LL);
        } else if (scanf("%d", &a[i]) != 1) {
            return 0;
        }
    }
    for (int i = 0; i < MAXN + 1 + GUARD; i++) pbuf[i] = CANARY;
    for (int i = 0; i < n; i++) ref[i + 1] = ref[i] + a[i];

    build_prefix(a, n, pbuf);
    for (int i = n + 1; i < n + 1 + GUARD; i++) {
        if (pbuf[i] != CANARY) {
            printf("OUT OF BOUNDS WRITE\n");
            return 0;
        }
    }

    uint64_t checksum = 0;
    for (int k = 0; k < q; k++) {
        int l, r;
        if (gen) {
            l = (int)(lcg(&x) % (uint32_t)n);
            r = (int)(lcg(&x) % (uint32_t)n);
            if (l > r) { int t = l; l = r; r = t; }
        } else if (scanf("%d %d", &l, &r) != 2) {
            return 0;
        }
        int64_t s = range_sum(pbuf, l, r);
        if (gen) {
            if (s != ref[r + 1] - ref[l]) {
                printf("WRONG on query %d (l=%d r=%d)\n", k, l, r);
                return 0;
            }
            checksum = checksum * 31u + (uint64_t)s;
        } else {
            printf("%lld\n", (long long)s);
        }
    }
    if (gen) printf("checksum: %llu\n", (unsigned long long)checksum);
    return 0;
}
