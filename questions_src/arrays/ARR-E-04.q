@@@ harness_code
#include <stdio.h>
#include <string.h>
#include <stddef.h>
#include <stdint.h>

/*USER_CODE*/

#define MAXN 1000000

static int buf[MAXN + 1];
static int copy[MAXN + 1];

int main(void)
{
    char tok[16];
    int n;
    if (scanf("%15s", tok) != 1) return 0;
    if (strcmp(tok, "GEN") == 0) {
        unsigned int seed;
        int missing;
        if (scanf("%d %u %d", &n, &seed, &missing) != 3) return 0;
        if (n < 0 || n > MAXN || missing < 0 || missing > n) return 0;
        int k = 0;
        for (int v = 0; v <= n; v++)
            if (v != missing) buf[k++] = v;
        uint32_t x = seed;
        for (int i = n - 1; i > 0; i--) {          /* Fisher-Yates with a fixed LCG */
            x = x * 1103515245u + 12345u;
            int j = (int)((x >> 8) % (uint32_t)(i + 1));
            int t = buf[i];
            buf[i] = buf[j];
            buf[j] = t;
        }
    } else {
        if (sscanf(tok, "%d", &n) != 1 || n < 0 || n > MAXN) return 0;
        for (int i = 0; i < n; i++)
            if (scanf("%d", &buf[i]) != 1) return 0;
    }
    memcpy(copy, buf, (size_t)n * sizeof buf[0]);

    int r = find_missing(n == 0 ? NULL : buf, n);

    if (memcmp(copy, buf, (size_t)n * sizeof buf[0]) != 0) {
        printf("ARRAY WAS MODIFIED\n");
        return 0;
    }
    printf("%d\n", r);
    return 0;
}
