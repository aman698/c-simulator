@@@ harness_code
#include <stdio.h>
#include <string.h>
#include <stdint.h>

/*USER_CODE*/

#define MAXN 1024

static ma_filter_t fa, fb;
static uint16_t ref_buf[MAXN];

int main(void)
{
    char tok[16];
    int n, m;
    int gen = 0;
    uint32_t x = 0;
    if (scanf("%15s", tok) != 1) return 0;
    if (strcmp(tok, "GEN") == 0) {
        unsigned int seed;
        if (scanf("%d %d %u", &n, &m, &seed) != 3) return 0;
        gen = 1;
        x = seed;
    } else if (sscanf(tok, "%d", &n) != 1 || scanf("%d", &m) != 1) {
        return 0;
    }
    if (n < 1 || n > MAXN || m < 1) return 0;

    memset(&fa, 0xA5, sizeof fa);           /* the filter starts on garbage */
    memset(&fb, 0x5A, sizeof fb);
    ma_init(&fa, (uint16_t)n);
    ma_init(&fb, 1);

    uint32_t rsum = 0;
    int ridx = 0, rcount = 0;
    uint64_t checksum = 0;
    for (int i = 0; i < m; i++) {
        unsigned int s;
        if (gen) {
            x = x * 1103515245u + 12345u;
            s = (x >> 12) & 0x0FFFu;                    /* 12-bit ADC value */
            if (((x >> 4) & 0xFFu) == 0) s = 65535u;   /* rare full-scale spike */
        } else if (scanf("%u", &s) != 1 || s > 65535u) {
            return 0;
        }
        uint16_t got = ma_update(&fa, (uint16_t)s);
        uint16_t echo = ma_update(&fb, (uint16_t)s);
        if (echo != (uint16_t)s) {
            printf("FILTER INSTANCES SHARE STATE\n");
            return 0;
        }
        /* reference */
        if (rcount == n) rsum -= ref_buf[ridx]; else rcount++;
        ref_buf[ridx] = (uint16_t)s;
        rsum += s;
        if (++ridx == n) ridx = 0;
        uint16_t want = (uint16_t)((rsum + (uint32_t)rcount / 2u) / (uint32_t)rcount);

        if (gen) {
            if (got != want) {
                printf("WRONG at sample %d: got %u, expected %u\n", i, (unsigned)got, (unsigned)want);
                return 0;
            }
            checksum = checksum * 1000003u + got;
        } else {
            printf("%u%c", (unsigned)got, i == m - 1 ? '\n' : ' ');
        }
    }
    if (gen) printf("checksum: %llu\n", (unsigned long long)checksum);
    return 0;
}
