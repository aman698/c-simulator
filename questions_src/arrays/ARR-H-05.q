@@@ harness_code
#include <stdio.h>
#include <string.h>
#include <stdint.h>
#include <stddef.h>
#include <limits.h>

#define qsort(...) qsort_is_not_allowed_in_this_exercise

/*USER_CODE*/

#undef qsort

#define MAXN 1000000

static int ids[MAXN];
static unsigned char seen[MAXN + 2];

static uint32_t lcg(uint32_t *x)
{
    *x = *x * 1103515245u + 12345u;
    return *x >> 8;
}

int main(void)
{
    char tok[16];
    int n;
    if (scanf("%15s", tok) != 1) return 0;
    if (strcmp(tok, "GEN") == 0) {
        unsigned int seed;
        int holes;
        if (scanf("%d %u %d", &n, &seed, &holes) != 3 || n < 1 || n > MAXN || holes < 0) return 0;
        uint32_t x = seed;
        for (int i = 0; i < n; i++) ids[i] = i + 1;
        for (int h = 0; h < holes; h++) {
            int at = (int)(lcg(&x) % (uint32_t)n);
            switch (lcg(&x) % 6u) {
            case 0:  ids[at] = 0; break;
            case 1:  ids[at] = -(int)(lcg(&x) % 1000000u) - 1; break;
            case 2:  ids[at] = n + 1 + (int)(lcg(&x) % 1000000u); break;
            case 3:  ids[at] = INT_MIN; break;
            case 4:  ids[at] = INT_MAX; break;
            default: ids[at] = ids[lcg(&x) % (uint32_t)n]; break;   /* duplicate */
            }
        }
        for (int i = n - 1; i > 0; i--) {
            int j = (int)(lcg(&x) % (uint32_t)(i + 1));
            int t = ids[i]; ids[i] = ids[j]; ids[j] = t;
        }
    } else {
        if (sscanf(tok, "%d", &n) != 1 || n < 0 || n > MAXN) return 0;
        for (int i = 0; i < n; i++)
            if (scanf("%d", &ids[i]) != 1) return 0;
    }

    int want = 1;
    for (int i = 0; i < n; i++)
        if (ids[i] >= 1 && ids[i] <= n) seen[ids[i]] = 1;
    while (want <= n && seen[want]) want++;

    int got = lowest_free_id(n == 0 ? NULL : ids, n);
    if (got != want) {
        printf("%d (WRONG)\n", got);
        return 0;
    }
    printf("%d\n", got);
    return 0;
}
