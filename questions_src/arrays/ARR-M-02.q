@@@ harness_code
#include <stdio.h>
#include <string.h>
#include <stdint.h>

/*USER_CODE*/

#define MAXN 1000000

static int32_t a[MAXN];

int main(void)
{
    char tok[16];
    int n;
    long long target;
    if (scanf("%15s", tok) != 1) return 0;
    if (strcmp(tok, "GEN") == 0) {
        unsigned int seed;
        int start, maxstep;
        if (scanf("%d %u %d %d %lld", &n, &seed, &start, &maxstep, &target) != 5) return 0;
        if (n < 0 || n > MAXN || maxstep < 0) return 0;
        uint32_t x = seed;
        int64_t v = start;
        for (int i = 0; i < n; i++) {
            if (i > 0) {
                x = x * 1103515245u + 12345u;
                v += (int64_t)((x >> 16) % ((uint32_t)maxstep + 1u));
                if (v > INT32_MAX) v = INT32_MAX;
            }
            a[i] = (int32_t)v;
        }
    } else {
        if (sscanf(tok, "%d", &n) != 1 || scanf("%lld", &target) != 1) return 0;
        if (n < 0 || n > MAXN) return 0;
        for (int i = 0; i < n; i++)
            if (scanf("%d", &a[i]) != 1) return 0;
    }
    int64_t r = count_pairs(n == 0 ? NULL : a, n, (int64_t)target);
    printf("%lld\n", (long long)r);
    return 0;
}
