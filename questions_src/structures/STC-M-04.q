 */

struct Pdu *pdu_new(uint32_t can_id, uint16_t cap)
{
    /* TODO: one allocation for header + cap bytes */
    (void)can_id;
    (void)cap;
    return NULL;
}

int pdu_append(struct Pdu **pp, const uint8_t *bytes, uint16_t n)
{
    /* TODO */
    (void)pp;
    (void)bytes;
    (void)n;
    return -1;
}
@@@ harness_code
#include <stdio.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

#define PDU_MAX 4095u

struct Pdu {
    uint32_t can_id;
    uint16_t len;
    uint16_t cap;
    uint8_t  data[];
};

/*USER_CODE*/

static void print_pdu(const struct Pdu *p)
{
    printf("len=%u cap=%u data=", (unsigned)p->len, (unsigned)p->cap);
    if (p->len == 0) {
        printf("-\n");
    } else if (p->len <= 16) {
        for (unsigned i = 0; i < p->len; i++) printf("%s%02X", i ? " " : "", (unsigned)p->data[i]);
        printf("\n");
    } else {
        unsigned sum = 0;
        for (unsigned i = 0; i < p->len; i++) sum += p->data[i];
        for (unsigned i = 0; i < 4; i++) printf("%02X ", (unsigned)p->data[i]);
        printf("...");
        for (unsigned i = p->len - 4u; i < p->len; i++) printf(" %02X", (unsigned)p->data[i]);
        printf(" sum=%u\n", sum);
    }
}

/* Touch the last byte of the claimed capacity: AddressSanitizer catches an undersized block. */
static void probe(struct Pdu *p)
{
    if (p->cap > p->len) p->data[p->cap - 1] = 0x5A;
}

int main(void)
{
    static uint8_t buf[5000];
    char cmd[8];
    struct Pdu *p = NULL;
    uint32_t id = 0;

    while (scanf("%7s", cmd) == 1) {
        if (strcmp(cmd, "NEW") == 0) {
            unsigned hid;
            int cap;
            if (scanf("%x %d", &hid, &cap) != 2) break;
            free(p);
            id = (uint32_t)hid;
            p = pdu_new(id, (uint16_t)cap);
            if (p == NULL) { printf("NEW returned NULL\n"); return 0; }
            printf("NEW 0x%X ", (unsigned)p->can_id);
            print_pdu(p);
            probe(p);
            continue;
        }
        int n, rc;
        if (scanf("%d", &n) != 1 || n < 0 || n > 5000) break;
        if (strcmp(cmd, "APP") == 0) {
            for (int i = 0; i < n; i++) {
                unsigned b;
                if (scanf("%x", &b) != 1) return 0;
                buf[i] = (uint8_t)b;
            }
        } else {
            int start;
            if (scanf("%d", &start) != 1) break;
            for (int i = 0; i < n; i++) buf[i] = (uint8_t)((start + i) & 0xFF);
        }
        rc = pdu_append(&p, n ? buf : NULL, (uint16_t)n);
        if (p == NULL) { printf("PDU pointer lost\n"); return 0; }
        if (p->can_id != id) printf("HEADER CORRUPTED\n");
        if (rc == 0) printf("OK ");
        else printf("ERR %d ", rc);
        print_pdu(p);
        probe(p);
    }
    free(p);
    return 0;
}
