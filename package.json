{
  "name": "c-practice-simulator",
  "private": true,
  "version": "1.0.0",
  "description": "LeetCode-style C programming practice simulator for embedded/automotive interview preparation, with a real gcc judge.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build_questions.js --quiet && concurrently -k -n judge,web -c cyan,magenta \"node server/index.js\" \"vite\"",
    "server": "node server/index.js",
    "web": "vite",
    "build": "npm run build:questions && tsc -p client/tsconfig.json --noEmit && vite build",
    "start": "npm run build && node server/index.js --serve",
    "build:questions": "node scripts/build_questions.js",
    "validate": "node scripts/build_questions.js --strict && node scripts/validate_questions.js",
    "q": "node scripts/qtool.js",
    "typecheck": "tsc -p client/tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "highlight.js": "^11.12.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
